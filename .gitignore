# Virtual Environment
.venv/
env/
venv/
.cache/
.hf_cache/
.pytest_cache/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# macOS specific
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# Dataset raw archives and processed images (reproducible via scripts/download_dataset.py)
data/raw/*.zip
data/processed/
data/external/

# Model Checkpoints (large binary weights)
models/*.pt
*.pt

# Training runs & intermediate artifacts
runs/
*.log
reports/inference/

# Editor & IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# SQLite temporary journal/wal files
*.db-wal
*.db-shm
